   "source": [
    "from pathlib import Path\n",
    "import traceback\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import SimpleITK as sitk\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Compatibility fixes for older PyLIDC\n",
    "# ---------------------------------------------------------\n",
    "if not hasattr(np, \"int\"):\n",
    "    np.int = int\n",
    "\n",
    "if not hasattr(np, \"bool\"):\n",
    "    np.bool = bool\n",
    "\n",
    "import pylidc as pl\n",
    "from pylidc.utils import consensus\n",
    "from radiomics import featureextractor\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# PROJECT PATHS\n",
    "# =========================================================\n",
    "\n",
    "PROJECT_FOLDER = Path(\n",
    "    r\"C:\\Users\\bwescott2023\\LIDC_RADIOMICS\"\n",
    ")\n",
    "\n",
    "OUTPUT_FOLDER = PROJECT_FOLDER / \"output\"\n",
    "OUTPUT_FOLDER.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "FINAL_FEATURE_FILE = (\n",
    "    OUTPUT_FOLDER / \"lidc_all_radiomics_features.csv\"\n",
    ")\n",
    "\n",
    "PROGRESS_FILE = (\n",
    "    OUTPUT_FOLDER / \"lidc_radiomics_progress.csv\"\n",
    ")\n",
    "\n",
    "ERROR_FILE = (\n",
    "    OUTPUT_FOLDER / \"lidc_radiomics_errors.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# PYRADIOMICS SETTINGS\n",
    "# =========================================================\n",
    "\n",
    "settings = {\n",
    "    \"binWidth\": 25,\n",
    "    \"normalize\": False,\n",
    "    \"removeOutliers\": None,\n",
    "    \"resampledPixelSpacing\": None,\n",
    "    \"interpolator\": sitk.sitkBSpline,\n",
    "    \"label\": 1,\n",
    "    \"correctMask\": True,\n",
    "}\n",
    "\n",
    "extractor = featureextractor.RadiomicsFeatureExtractor(\n",
    "    **settings\n",
    ")\n",
    "\n",
    "# Disable everything first\n",
    "extractor.disableAllFeatures()\n",
    "\n",
    "# Enable the feature groups we used\n",
    "extractor.enableFeatureClassByName(\"shape\")\n",
    "extractor.enableFeatureClassByName(\"firstorder\")\n",
    "extractor.enableFeatureClassByName(\"glcm\")\n",
    "extractor.enableFeatureClassByName(\"glrlm\")\n",
    "extractor.enableFeatureClassByName(\"glszm\")\n",
    "extractor.enableFeatureClassByName(\"gldm\")\n",
    "extractor.enableFeatureClassByName(\"ngtdm\")\n",
    "\n",
    "print(\"Enabled feature classes:\")\n",
    "print(extractor.enabledFeatures)\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# RATING HELPERS\n",
    "# =========================================================\n",
    "\n",
    "RATING_FIELDS = [\n",
    "    \"malignancy\",\n",
    "    \"subtlety\",\n",
    "    \"internalStructure\",\n",
    "    \"calcification\",\n",
    "    \"sphericity\",\n",
    "    \"margin\",\n",
    "    \"lobulation\",\n",
    "    \"spiculation\",\n",
    "    \"texture\",\n",
    "]\n",
    "\n",
    "\n",
    "def get_rating_values(annotations, attribute):\n",
    "    values = []\n",
    "\n",
    "    for annotation in annotations:\n",
    "        value = getattr(\n",
    "            annotation,\n",
    "            attribute,\n",
    "            None,\n",
    "        )\n",
    "\n",
    "        if value is not None:\n",
    "            values.append(float(value))\n",
    "\n",
    "    return values\n",
    "\n",
    "\n",
    "def get_mean_rating(annotations, attribute):\n",
    "    values = get_rating_values(\n",
    "        annotations,\n",
    "        attribute,\n",
    "    )\n",
    "\n",
    "    if not values:\n",
    "        return np.nan\n",
    "\n",
    "    return float(np.mean(values))\n",
    "\n",
    "\n",
    "def get_min_rating(annotations, attribute):\n",
    "    values = get_rating_values(\n",
    "        annotations,\n",
    "        attribute,\n",
    "    )\n",
    "\n",
    "    if not values:\n",
    "        return np.nan\n",
    "\n",
    "    return float(np.min(values))\n",
    "\n",
    "\n",
    "def get_max_rating(annotations, attribute):\n",
    "    values = get_rating_values(\n",
    "        annotations,\n",
    "        attribute,\n",
    "    )\n",
    "\n",
    "    if not values:\n",
    "        return np.nan\n",
    "\n",
    "    return float(np.max(values))\n",
    "\n",
    "\n",
    "def get_rating_sd(annotations, attribute):\n",
    "    values = get_rating_values(\n",
    "        annotations,\n",
    "        attribute,\n",
    "    )\n",
    "\n",
    "    if not values:\n",
    "        return np.nan\n",
    "\n",
    "    # Population SD\n",
    "    return float(np.std(values, ddof=0))\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# SIMPLEITK CONVERSION\n",
    "# =========================================================\n",
    "\n",
    "def numpy_to_sitk(\n",
    "    array,\n",
    "    pixel_spacing,\n",
    "    slice_spacing,\n",
    "    origin=None,\n",
    "    direction=None,\n",
    "    is_mask=False,\n",
    "):\n",
    "    \"\"\"\n",
    "    PyLIDC returns arrays as:\n",
    "        rows, columns, slices\n",
    "\n",
    "    SimpleITK expects:\n",
    "        slices, rows, columns\n",
    "\n",
    "    Therefore transpose:\n",
    "        (2, 0, 1)\n",
    "    \"\"\"\n",
    "\n",
    "    array = np.transpose(\n",
    "        array,\n",
    "        (2, 0, 1),\n",
    "    )\n",
    "\n",
    "    if is_mask:\n",
    "        array = array.astype(np.uint8)\n",
    "    else:\n",
    "        array = array.astype(np.float32)\n",
    "\n",
    "    image = sitk.GetImageFromArray(array)\n",
    "\n",
    "    image.SetSpacing(\n",
    "        (\n",
    "            float(pixel_spacing),\n",
    "            float(pixel_spacing),\n",
    "            float(slice_spacing),\n",
    "        )\n",
    "    )\n",
    "\n",
    "    if origin is not None:\n",
    "        image.SetOrigin(origin)\n",
    "\n",
    "    if direction is not None:\n",
    "        image.SetDirection(direction)\n",
    "\n",
    "    return image\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# GET DICOM GEOMETRY\n",
    "# =========================================================\n",
    "\n",
    "def get_dicom_geometry(scan):\n",
    "    \"\"\"\n",
    "    Read one DICOM slice so the exported image keeps\n",
    "    proper physical orientation and origin.\n",
    "    \"\"\"\n",
    "\n",
    "    dicom_path = Path(\n",
    "        scan.get_path_to_dicom_files()\n",
    "    )\n",
    "\n",
    "    dicom_files = sorted(\n",
    "        dicom_path.glob(\"*.dcm\")\n",
    "    )\n",
    "\n",
    "    if not dicom_files:\n",
    "        raise RuntimeError(\n",
    "            f\"No DICOM files found in {dicom_path}\"\n",
    "        )\n",
    "\n",
    "    reader = sitk.ImageSeriesReader()\n",
    "\n",
    "    series_ids = reader.GetGDCMSeriesIDs(\n",
    "        str(dicom_path)\n",
    "    )\n",
    "\n",
    "    if not series_ids:\n",
    "        raise RuntimeError(\n",
    "            f\"No readable DICOM series found in \"\n",
    "            f\"{dicom_path}\"\n",
    "        )\n",
    "\n",
    "    filenames = reader.GetGDCMSeriesFileNames(\n",
    "        str(dicom_path),\n",
    "        series_ids[0],\n",
    "    )\n",
    "\n",
    "    reader.SetFileNames(filenames)\n",
    "\n",
    "    image = reader.Execute()\n",
    "\n",
    "    return (\n",
    "        image.GetOrigin(),\n",
    "        image.GetDirection(),\n",
    "        image.GetSpacing(),\n",
    "    )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# SAVE PROGRESS SAFELY\n",
    "# =========================================================\n",
    "\n",
    "def safe_save_csv(\n",
    "    dataframe,\n",
    "    filepath,\n",
    "):\n",
    "    \"\"\"\n",
    "    Save to a temporary file first, then replace the target.\n",
    "    Helps avoid corrupt files if the program stops.\n",
    "    \"\"\"\n",
    "\n",
    "    filepath = Path(filepath)\n",
    "\n",
    "    temp_file = filepath.with_name(\n",
    "        filepath.stem\n",
    "        + \"_temp\"\n",
    "        + filepath.suffix\n",
    "    )\n",
    "\n",
    "    dataframe.to_csv(\n",
    "        temp_file,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    temp_file.replace(filepath)\n",
    "\n",
    "\n",
    "def save_progress(\n",
    "    feature_rows,\n",
    "    error_rows,\n",
    "):\n",
    "    if feature_rows:\n",
    "        df = pd.DataFrame(\n",
    "            feature_rows\n",
    "        )\n",
    "\n",
    "        safe_save_csv(\n",
    "            df,\n",
    "            PROGRESS_FILE,\n",
    "        )\n",
    "\n",
    "    if error_rows:\n",
    "        error_df = pd.DataFrame(\n",
    "            error_rows\n",
    "        )\n",
    "\n",
    "        safe_save_csv(\n",
    "            error_df,\n",
    "            ERROR_FILE,\n",
    "        )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# LOAD ALL LIDC SCANS\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\nLoading PyLIDC database...\")\n",
    "\n",
    "scans = pl.query(pl.Scan).all()\n",
    "\n",
    "print(\n",
    "    f\"Total scans found: {len(scans)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# STORAGE\n",
    "# =========================================================\n",
    "\n",
    "feature_rows = []\n",
    "error_rows = []\n",
    "\n",
    "successful_tumors = 0\n",
    "failed_tumors = 0\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# PROCESS EVERY PATIENT\n",
    "# =========================================================\n",
    "\n",
    "for scan_index, scan in enumerate(\n",
    "    scans,\n",
    "    start=1,\n",
    "):\n",
    "\n",
    "    patient_id = scan.patient_id\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\n",
    "        f\"Patient {scan_index}/{len(scans)}: \"\n",
    "        f\"{patient_id}\"\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        clusters = scan.cluster_annotations()\n",
    "\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            f\"Could not cluster annotations: {error}\"\n",
    "        )\n",
    "\n",
    "        error_rows.append(\n",
    "            {\n",
    "                \"patient_id\": patient_id,\n",
    "                \"tumor_number\": None,\n",
    "                \"case_id\": None,\n",
    "                \"error\": str(error),\n",
    "                \"traceback\": traceback.format_exc(),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        continue\n",
    "\n",
    "    if len(clusters) == 0:\n",
    "        print(\n",
    "            \"No clustered nodules. Skipping.\"\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    print(\n",
    "        f\"Distinct nodules: {len(clusters)}\"\n",
    "    )\n",
    "\n",
    "    # -----------------------------------------------------\n",
    "    # LOAD COMPLETE 3D CT\n",
    "    # -----------------------------------------------------\n",
    "\n",
    "    try:\n",
    "        ct_volume = scan.to_volume(\n",
    "            verbose=False\n",
    "        )\n",
    "\n",
    "        origin, direction, dicom_spacing = (\n",
    "            get_dicom_geometry(scan)\n",
    "        )\n",
    "\n",
    "        pixel_spacing = float(\n",
    "            scan.pixel_spacing\n",
    "        )\n",
    "\n",
    "        slice_spacing = float(\n",
    "            scan.slice_spacing\n",
    "        )\n",
    "\n",
    "        ct_image = numpy_to_sitk(\n",
    "            ct_volume,\n",
    "            pixel_spacing,\n",
    "            slice_spacing,\n",
    "            origin=origin,\n",
    "            direction=direction,\n",
    "            is_mask=False,\n",
    "        )\n",
    "\n",
    "    except Exception as error:\n",
    "        print(\n",
    "            f\"Could not load CT volume: {error}\"\n",
    "        )\n",
    "\n",
    "        error_rows.append(\n",
    "            {\n",
    "                \"patient_id\": patient_id,\n",
    "                \"tumor_number\": None,\n",
    "                \"case_id\": None,\n",
    "                \"error\": str(error),\n",
    "                \"traceback\": traceback.format_exc(),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    # =====================================================\n",
    "    # PROCESS EACH DISTINCT 3D NODULE\n",
    "    # =====================================================\n",
    "\n",
    "    for tumor_number, annotations in enumerate(\n",
    "        clusters,\n",
    "        start=1,\n",
    "    ):\n",
    "\n",
    "        case_id = (\n",
    "            f\"{patient_id}_nodule_\"\n",
    "            f\"{tumor_number:02d}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"\\n  Nodule \"\n",
    "            f\"{tumor_number}/{len(clusters)}: \"\n",
    "            f\"{case_id}\"\n",
    "        )\n",
    "\n",
    "        try:\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # BUILD 50% CONSENSUS SEGMENTATION\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            (\n",
    "                consensus_mask,\n",
    "                consensus_bbox,\n",
    "                individual_masks,\n",
    "            ) = consensus(\n",
    "                annotations,\n",
    "                clevel=0.5,\n",
    "                pad=0,\n",
    "                ret_masks=True,\n",
    "            )\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # PUT CONSENSUS MASK BACK INTO FULL CT SPACE\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            full_mask = np.zeros(\n",
    "                ct_volume.shape,\n",
    "                dtype=np.uint8,\n",
    "            )\n",
    "\n",
    "            full_mask[\n",
    "                consensus_bbox\n",
    "            ] = consensus_mask.astype(\n",
    "                np.uint8\n",
    "            )\n",
    "\n",
    "            voxel_count = int(\n",
    "                np.count_nonzero(\n",
    "                    full_mask\n",
    "                )\n",
    "            )\n",
    "\n",
    "            if voxel_count == 0:\n",
    "                raise RuntimeError(\n",
    "                    \"Consensus mask contains zero voxels.\"\n",
    "                )\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # NUMBER OF CT SLICES CONTAINING TUMOR\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            slice_count = int(\n",
    "                np.count_nonzero(\n",
    "                    np.any(\n",
    "                        full_mask > 0,\n",
    "                        axis=(0, 1),\n",
    "                    )\n",
    "                )\n",
    "            )\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # CONVERT MASK TO SIMPLEITK\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            mask_image = numpy_to_sitk(\n",
    "                full_mask,\n",
    "                pixel_spacing,\n",
    "                slice_spacing,\n",
    "                origin=origin,\n",
    "                direction=direction,\n",
    "                is_mask=True,\n",
    "            )\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # RADIOMICS\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            result = extractor.execute(\n",
    "                ct_image,\n",
    "                mask_image,\n",
    "            )\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # START OUTPUT ROW\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            row = {\n",
    "                \"tumor_id\": case_id,\n",
    "                \"patient_id\": patient_id,\n",
    "                \"tumor_number\": tumor_number,\n",
    "                \"number_of_radiologists\":\n",
    "                    len(annotations),\n",
    "\n",
    "                \"average_malignancy\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"malignancy\",\n",
    "                    ),\n",
    "\n",
    "                \"average_subtlety\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"subtlety\",\n",
    "                    ),\n",
    "\n",
    "                \"average_internal_structure\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"internalStructure\",\n",
    "                    ),\n",
    "\n",
    "                \"average_calcification\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"calcification\",\n",
    "                    ),\n",
    "\n",
    "                \"average_sphericity_rating\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"sphericity\",\n",
    "                    ),\n",
    "\n",
    "                \"average_margin\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"margin\",\n",
    "                    ),\n",
    "\n",
    "                \"average_lobulation\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"lobulation\",\n",
    "                    ),\n",
    "\n",
    "                \"average_spiculation\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"spiculation\",\n",
    "                    ),\n",
    "\n",
    "                \"average_texture\":\n",
    "                    get_mean_rating(\n",
    "                        annotations,\n",
    "                        \"texture\",\n",
    "                    ),\n",
    "\n",
    "                \"minimum_malignancy\":\n",
    "                    get_min_rating(\n",
    "                        annotations,\n",
    "                        \"malignancy\",\n",
    "                    ),\n",
    "\n",
    "                \"maximum_malignancy\":\n",
    "                    get_max_rating(\n",
    "                        annotations,\n",
    "                        \"malignancy\",\n",
    "                    ),\n",
    "\n",
    "                \"malignancy_standard_deviation\":\n",
    "                    get_rating_sd(\n",
    "                        annotations,\n",
    "                        \"malignancy\",\n",
    "                    ),\n",
    "\n",
    "                \"mask_voxel_count\":\n",
    "                    voxel_count,\n",
    "\n",
    "                \"number_of_ct_slices\":\n",
    "                    slice_count,\n",
    "            }\n",
    "\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # ADD PYRADIOMICS FEATURES\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            feature_count = 0\n",
    "\n",
    "            for feature_name, value in (\n",
    "                result.items()\n",
    "            ):\n",
    "\n",
    "                # Ignore diagnostic fields\n",
    "                if feature_name.startswith(\n",
    "                    \"diagnostics_\"\n",
    "                ):\n",
    "                    continue\n",
    "\n",
    "                # Convert numpy objects to normal values\n",
    "                if isinstance(\n",
    "                    value,\n",
    "                    np.generic,\n",
    "                ):\n",
    "                    value = value.item()\n",
    "\n",
    "                row[\n",
    "                    feature_name\n",
    "                ] = value\n",
    "\n",
    "                feature_count += 1\n",
    "\n",
    "\n",
    "            # -------------------------------------------------\n",
    "            # STORE RESULT\n",
    "            # -------------------------------------------------\n",
    "\n",
    "            feature_rows.append(row)\n",
    "\n",
    "            successful_tumors += 1\n",
    "\n",
    "            print(\n",
    "                f\"  SUCCESS | \"\n",
    "                f\"Voxels: {voxel_count} | \"\n",
    "                f\"Slices: {slice_count} | \"\n",
    "                f\"Features: {feature_count}\"\n",
    "            )\n",
    "\n",
    "\n",
    "        except Exception as error:\n",
    "\n",
    "            failed_tumors += 1\n",
    "\n",
    "            print(\n",
    "                f\"  FAILED: \"\n",
    "                f\"{type(error).__name__}: \"\n",
    "                f\"{error}\"\n",
    "            )\n",
    "\n",
    "            error_rows.append(\n",
    "                {\n",
    "                    \"patient_id\":\n",
    "                        patient_id,\n",
    "\n",
    "                    \"tumor_number\":\n",
    "                        tumor_number,\n",
    "\n",
    "                    \"case_id\":\n",
    "                        case_id,\n",
    "\n",
    "                    \"error_type\":\n",
    "                        type(error).__name__,\n",
    "\n",
    "                    \"error\":\n",
    "                        str(error),\n",
    "\n",
    "                    \"traceback\":\n",
    "                        traceback.format_exc(),\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "        # -----------------------------------------------------\n",
    "        # SAVE AFTER EACH TUMOR\n",
    "        # -----------------------------------------------------\n",
    "\n",
    "        try:\n",
    "            save_progress(\n",
    "                feature_rows,\n",
    "                error_rows,\n",
    "            )\n",
    "\n",
    "        except PermissionError:\n",
    "\n",
    "            print(\n",
    "                \"\\nWARNING: Could not save progress file.\"\n",
    "            )\n",
    "            print(\n",
    "                \"Make sure the CSV is NOT open in Excel.\"\n",
    "            )\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# FINAL SAVE\n",
    "# =========================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"Extraction finished.\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "if feature_rows:\n",
    "\n",
    "    final_df = pd.DataFrame(\n",
